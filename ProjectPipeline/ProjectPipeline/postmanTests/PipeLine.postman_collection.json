		"_exporter_id": "47090438",
		"_collection_link": "https://nileshmungase264-9827126.postman.co/workspace/StepUp-Workspace~e0348089-d83a-4510-8a49-f9f7e11d0097/collection/47090438-d6d2318d-9077-422b-bfb0-90dd25b91fcf?action=share&source=collection_link&creator=47090438"
	},
	"item": [
		{
			"name": "ProjPipeline",
			"event": [
				{
					"listen": "test",
					"script": {
						"exec": [
							"// ---------- Configuration: customize per request ----------",
							"const expected = {",
							"    statusCode: 200,                        // e.g. 200",
							"    // Whether you expect a JSON object or array at the top level",
							"    topLevelType: 'object',                 // 'object' or 'array'",
							"    // Expected fields and their JS data types.",
							"    // Types: 'string' | 'number' | 'boolean' | 'object' | 'array' | 'null'",
							"    fields: {",
							"        'id': 'null',",
							"        'message': 'string',",
							"        'timestamp': 'string'",
							"    }",
							"};",
							"// ----------------------------------------------------------",
							"",
							"// 1. Validate HTTP status code",
							"pm.test(`Status code is ${expected.statusCode}`, function () {",
							"    pm.response.to.have.status(expected.statusCode);",
							"});",
							"",
							"// 2. Validate response time is less than 2000ms",
							"pm.test('Response time is less than 2000ms', function () {",
							"    pm.expect(pm.response.responseTime).to.be.below(2000);",
							"});",
							"",
							"// 3. Validate response is JSON",
							"pm.test('Response has JSON content-type', function () {",
							"    pm.response.to.have.header('Content-Type');",
							"    pm.expect(pm.response.headers.get('Content-Type').toLowerCase())",
							"        .to.include('application/json');",
							"});",
							"",
							"let jsonData;",
							"pm.test('Response body is valid JSON', function () {",
							"    jsonData = pm.response.json();",
							"});",
							"",
							"// 4. Validate top-level JSON type (object/array)",
							"pm.test(`Response top-level is a ${expected.topLevelType}`, function () {",
							"    pm.expect(jsonData).to.not.equal(undefined);",
							"    if (expected.topLevelType === 'object') {",
							"        pm.expect(jsonData).to.be.an('object');",
							"    } else if (expected.topLevelType === 'array') {",
							"        pm.expect(jsonData).to.be.an('array');",
							"    }",
							"});",
							"",
							"// Helper: get object to validate (for arrays, validate first element)",
							"function getTargetObject() {",
							"    if (Array.isArray(jsonData)) {",
							"        pm.expect(jsonData.length, 'response array should not be empty').to.be.above(0);",
							"        return jsonData[0];",
							"    }",
							"    return jsonData;",
							"}",
							"",
							"const target = getTargetObject();",
							"",
							"// 5. Validate required fields are present",
							"pm.test('Required fields are present', function () {",
							"    Object.keys(expected.fields).forEach(function (field) {",
							"        pm.expect(target, `Missing required field: ${field}`).to.have.property(field);",
							"    });",
							"});",
							"",
							"// 5b. Validate field data types",
							"pm.test('Field data types are correct', function () {",
							"    Object.entries(expected.fields).forEach(function ([field, type]) {",
							"        pm.expect(target, `Missing field: ${field}`).to.have.property(field);",
							"",
							"        const value = target[field];",
							"",
							"        // Handle array type separately",
							"        if (type === 'array') {",
							"            pm.expect(value, `Field '${field}' should be an array`).to.be.an('array');",
							"            return;",
							"        }",
							"",
							"        // Handle null explicitly",
							"        if (type === 'null') {",
							"            pm.expect(value, `Field '${field}' should be null`).to.be.null;",
							"            return;",
							"        }",
							"",
							"        // Other primitive/object types",
							"        pm.expect(value, `Field '${field}' should be of type ${type}`)",
							"            .to.be.a(type);",
							"    });",
							"});",
							"",
							"// 6. Handle negative scenarios (4xx/5xx)",
							"// This block is useful when you run the same request with different",
							"// examples or data sets that should trigger errors.",
							"",
							"pm.test('Negative scenario handling', function () {",
							"    const status = pm.response.code;",
							"",
							"    if (status >= 400 && status < 500) {",
							"        // Client error expectations",
							"        pm.expect(status, 'Client error should be 4xx').to.be.within(400, 499);",
							"        // Optional: check for typical error structure from Spring Boot",
							"        // e.g. {\"timestamp\": \"...\", \"status\": 400, \"error\": \"...\", \"message\": \"...\", \"path\": \"...\"}",
							"        try {",
							"            const errBody = pm.response.json();",
							"            pm.expect(errBody).to.be.an('object');",
							"            ['timestamp', 'status', 'error', 'message', 'path'].forEach(function (f) {",
							"                if (errBody.hasOwnProperty(f)) {",
							"                    pm.expect(errBody, `Error body should contain '${f}'`).to.have.property(f);",
							"                }",
							"            });",
							"        } catch (e) {",
							"            // If non-JSON errors are returned, just note it",
							"            console.warn('4xx error response is not JSON or cannot be parsed');",
							"        }",
							"    } else if (status >= 500 && status < 600) {",
							"        // Server error expectations",
							"        pm.expect(status, 'Server error should be 5xx').to.be.within(500, 599);",
							"        try {",
							"            const errBody = pm.response.json();",
							"            pm.expect(errBody).to.be.an('object');",
							"            if (errBody.message) {",
							"                pm.expect(errBody.message).to.be.a('string');",
							"            }",
							"        } catch (e) {",
							"            console.warn('5xx error response is not JSON or cannot be parsed');",
							"        }",
							"    } else {",
							"        // For non-error (2xx/3xx) responses, this test just passes",
							"        pm.expect(status, 'Non-error status for main scenario').to.be.below(400);",
							"    }",
							"});"
						],
						"type": "text/javascript",
						"packages": {},
						"requests": {}
					}
				}
			],
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8045/status",
					"protocol": "http",
					"host": [
						"localhost"
					],
					"port": "8045",
					"path": [
						"status"
					]
				}
			},
			"response": []
		}
	]
}